---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const categories = await getAllCategories(getDatabase());
const publishers = await getAllPublishers(getDatabase());
const games = await getAllGames(getDatabase());
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div class="mb-8 rounded-2xl border border-slate-700 bg-slate-900/60 p-5 shadow-lg">
      <form aria-label="Filter games" data-testid="game-filters" class="space-y-5">
        <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
          <fieldset data-testid="category-filter-group" class="flex-1 border-0 p-0 m-0">
            <legend class="mb-3 text-sm font-semibold uppercase tracking-[0.15em] text-slate-300">
              Categories
            </legend>
            <div class="flex flex-wrap gap-2">
              {categories.map((category) => (
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition hover:border-blue-500 hover:bg-slate-700 focus-within:ring-2 focus-within:ring-blue-500 focus-within:outline-none">
                  <input
                    type="checkbox"
                    name="category"
                    value={category.id}
                    data-testid={`category-filter-${category.id}`}
                    class="size-4 rounded border-slate-600 bg-slate-950 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset data-testid="publisher-filter-group" class="flex-1 border-0 p-0 m-0">
            <legend class="mb-3 text-sm font-semibold uppercase tracking-[0.15em] text-slate-300">
              Publishers
            </legend>
            <div class="flex flex-wrap gap-2">
              {publishers.map((publisher) => (
                <label class="inline-flex cursor-pointer items-center gap-2 rounded-full border border-slate-700 bg-slate-800 px-3 py-2 text-sm text-slate-200 transition hover:border-purple-500 hover:bg-slate-700 focus-within:ring-2 focus-within:ring-purple-500 focus-within:outline-none">
                  <input
                    type="checkbox"
                    name="publisher"
                    value={publisher.id}
                    data-testid={`publisher-filter-${publisher.id}`}
                    class="size-4 rounded border-slate-600 bg-slate-950 text-purple-500 focus:ring-2 focus:ring-purple-500 focus:outline-none"
                  />
                  <span>{publisher.name}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <button
            type="button"
            data-testid="clear-filters-button"
            class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm font-medium text-slate-100 transition hover:border-slate-500 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          >
            Clear filters
          </button>
          <p class="text-sm text-slate-300" data-testid="filter-summary" aria-live="polite">
            {games.length} games
          </p>
        </div>
      </form>
    </div>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div
            data-testid="filter-empty-state"
            hidden
            class="mt-6 rounded-xl border border-slate-700 bg-slate-800/60 p-6 text-center text-slate-300"
          >
            No games match the selected filters.
          </div>
        </>
      )}
    </div>
  </div>

  <script>
    const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
    const gamesGrid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
    const filterSummary = document.querySelector<HTMLElement>('[data-testid="filter-summary"]');
    const clearFiltersButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters-button"]');
    const allCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    const getSelectedValues = (name: 'category' | 'publisher') =>
      Array.from(document.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map((input) =>
        Number(input.value),
      );

    const updateGameVisibility = () => {
      const selectedCategories = getSelectedValues('category');
      const selectedPublishers = getSelectedValues('publisher');
      let visibleCount = 0;

      allCards.forEach((card) => {
        const categoryId = Number(card.dataset.categoryId ?? NaN);
        const publisherId = Number(card.dataset.publisherId ?? NaN);
        const matchesCategory =
          selectedCategories.length === 0 || selectedCategories.includes(categoryId);
        const matchesPublisher =
          selectedPublishers.length === 0 || selectedPublishers.includes(publisherId);
        const shouldShow = matchesCategory && matchesPublisher;

        card.hidden = !shouldShow;
        if (shouldShow) {
          visibleCount += 1;
        }
      });

      if (gamesGrid) {
        gamesGrid.hidden = visibleCount === 0;
      }
      if (emptyState) {
        emptyState.hidden = visibleCount !== 0;
      }
      if (filterSummary) {
        const label = visibleCount === 1 ? 'game' : 'games';
        filterSummary.textContent = `${visibleCount} ${label}`;
      }
    };

    filterForm?.addEventListener('change', updateGameVisibility);
    clearFiltersButton?.addEventListener('click', () => {
      document
        .querySelectorAll<HTMLInputElement>('input[name="category"], input[name="publisher"]')
        .forEach((input) => {
          input.checked = false;
        });
      updateGameVisibility();
    });

    updateGameVisibility();
  </script>
</Layout>
